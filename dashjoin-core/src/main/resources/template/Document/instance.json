{
    "widget": "page",
    "children": [
        {
            "title": "Edit Tags",
            "widget": "edit"
        },
        {
            "text": "Add new tag",
            "widget": "button",
            "onClick": "($update('kb', 'Document', value.id, {'tags': $append(value.tags, form.tag)}); $reload())",
            "schema": {
                "type": "object",
                "required": [
                    "tag"
                ],
                "properties": {
                    "tag": {
                        "type": "string",
                        "title": "Tag"
                    }
                }
            }
        },
        {
            "title": "Document Info",
            "widget": "display",
            "display": "value",
            "schema": {
                "properties": {
                    "text": {
                        "icon": "text_snippet"
                    },
                    "owner": {
                        "icon": "person"
                    },
                    "path": {
                        "icon": "terminal"
                    },
                    "size": {
                        "icon": "data_usage"
                    },
                    "tags": {
                        "icon": "tag"
                    }
                }
            }
        }
    ]
}
