{
    "ID": "Info",
    "layout": {
        "widget": "page",
        "children": [
            {
                "widget": "container",
                "children": [
                    {
                        "widget": "display",
                        "display": "{\"user\": user}",
                        "schema": {
                            "properties": {
                                "user": {
                                    "icon": "account_circle"
                                }
                            }
                        }
                    },
                    {
                        "widget": "display",
                        "display": "{\"email\": email}",
                        "schema": {
                            "properties": {
                                "email": {
                                    "icon": "email"
                                }
                            }
                        }
                    },
                    {
                        "widget": "display",
                        "display": "{\"roles\": $djRoles()}",
                        "schema": {
                            "properties": {
                                "roles": {
                                    "icon": "person_search"
                                }
                            }
                        }
                    },
                    {
                        "widget": "text",
                        "text": "System Roles",
                        "href": "/table/config/dj-role",
                        "icon": "people_outline"
                    },
                    {
                        "widget": "text",
                        "text": "User",
                        "href": "/table/config/user",
                        "icon": "people"
                    },
                    {
                        "widget": "text",
                        "text": "Tenant Users",
                        "href": "/table/config/tenantusers",
                        "icon": "people"
                    }
                ],
                "title": "User Information",
                "card": true,
                "class": "md:col-span-3 h-full"
            },
            {
                "widget": "container",
                "title": "App",
                "children": [
                    {
                        "markdown": "&nbsp;&nbsp;&nbsp;&nbsp;<span class='material-icons'>terminal</span>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<a target='expert' href='${context}'>Dashjoin Studio</a>",
                        "context": "(\n$parse := href.$split(\"/\");\n$hostPort := $parse[2].$split(\":\");\n$host := $hostPort[0];\n$port := $hostPort[1] ? $hostPort[1] : ($parse[0] = \"http:\" ? 80 : 443);\n$parse[0] & \"//\" & $host & \":\" & ($number($port)+1)\n)",
                        "widget": "markdown"
                    },
                    {
                        "widget": "text",
                        "href": "/page/OpenAPI",
                        "icon": "webhook",
                        "text": "App API"
                    },
                    {
                        "widget": "text",
                        "href": "/page/Lint",
                        "icon": "report",
                        "text": "Lint"
                    },
                    {
                        "widget": "text",
                        "href": "/config/dj-library",
                        "icon": "functions",
                        "text": "Function Library"
                    },
                    {
                        "widget": "text",
                        "text": "Notebook",
                        "href": "/page/Notebook",
                        "icon": "edit_note"
                    },
                    {
                        "widget": "text",
                        "text": "Git",
                        "href": "/page/App",
                        "icon": "computer"
                    }
                ],
                "card": true,
                "class": "md:col-span-3 h-full"
            },
            {
                "widget": "container",
                "title": "Configuration",
                "children": [
                    {
                        "widget": "text",
                        "href": "/table/config/dj-config",
                        "icon": "build",
                        "text": "System Configuration"
                    },
                    {
                        "widget": "text",
                        "href": "/resource/config/dj-database/dj%2Fconfig",
                        "icon": "build_circle",
                        "text": "Configuration Database"
                    }
                ],
                "card": true,
                "class": "md:col-span-3 h-full"
            },
            {
                "widget": "container",
                "title": "Databases",
                "children": [
                    {
                        "widget": "text",
                        "href": "/table/config/dj-query-performance",
                        "icon": "speed",
                        "text": "Query / Expression Performance"
                    },
                    {
                        "widget": "text",
                        "href": "/page/ERDiagram",
                        "icon": "schema",
                        "text": "ER Diagram"
                    },
                    {
                        "widget": "text",
                        "href": "/page/DataCatalog",
                        "icon": "library_books",
                        "text": "Data Catalog"
                    },
                    {
                        "widget": "text",
                        "href": "/page/BusinessLogicCatalog",
                        "icon": "functions",
                        "text": "Business Logic Catalog"
                    }
                ],
                "card": true,
                "class": "md:col-span-3 h-full"
            },
            {
                "widget": "display",
                "card": true,
                "display": "( $f:=function($x){ $merge( [$x, {\"Third party licenses\": {\"href\": \"https://download.dashjoin.com/dashjoin/release/\" & $substringBefore($x.version, '-') & \"/license-report.html\"}}]) }; $f($djVersion()) )",
                "title": "Software",
                "schema": {
                    "properties": {
                        "version": {
                            "icon": "content_copy"
                        },
                        "vendor": {
                            "icon": "store"
                        },
                        "name": {
                            "icon": "check_circle_outline"
                        },
                        "buildTime": {
                            "icon": "access_time"
                        },
                        "runtime": {
                            "icon": "build"
                        },
                        "Third party licenses": {
                            "icon": "copyright"
                        },
                        "title": {
                            "icon": "title"
                        },
                        "appurl": {
                            "icon": "download"
                        },
                        "home": {
                            "icon": "home_filled"
                        },
                        "workingDir": {
                            "icon": "folder"
                        }
                    }
                }
            },
            {
                "widget": "table",
                "expression": "$djGetDatabases()",
                "title": "Database Drivers"
            },
            {
                "widget": "table",
                "expression": "$djGetDrivers()",
                "title": "JDBC Drivers"
            },
            {
                "widget": "table",
                "expression": "$djGetFunctions()",
                "title": "Functions"
            }
        ]
    }
}